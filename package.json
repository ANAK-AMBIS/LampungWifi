{
  "name": "balamwifi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"next dev\"",
    "dev:client": "next dev",
    "dev:api": "node --watch server/index.js",
    "dev:server": "npm run dev:api",
    "build": "next build",
    "db:seed": "node server/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "npm run start",
    "start": "concurrently -k \"node server/index.js\" \"next start\"",
    "start:api": "node server/index.js",
    "start:next": "next start"
  },
  "dependencies": {
    "@cloudflare/speedtest": "^1.13.1",
    "@types/leaflet": "^1.9.22",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "next": "^16.0.8",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
