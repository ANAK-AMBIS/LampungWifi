# ── Server ──────────────────────────────────────────
PORT=8787
CORS_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/balamwifi?sslmode=require
DB_SCHEMA_SYNC=true

# ── Auth ───────────────────────────────────────────
ADMIN_TOKEN=change-this-admin-token
SESSION_SECRET=change-me-32chars-random
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── API ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=/api
API_SERVER_URL=http://localhost:8787

# ── Speedtest Hygiene ──────────────────────────────
SPEEDTEST_MAX_DISTANCE_M=150
NEXT_PUBLIC_SPEEDTEST_MAX_DISTANCE_M=150

# ── Site ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_IMAGE_REMOTE_HOSTS=i.ibb.co,images.unsplash.com,lh3.googleusercontent.com
